# NER Logistics Resilience & Accessibility Intelligence Platform
# ---------------------------------------------------------------------------
# Copy to .env at the repository root and edit. Every key below is read by
# services/api/app/core/config.py; the values shown are that module's defaults,
# so an empty .env boots a working development stack. Keys are listed in the
# same order as the settings class, and scripts/verify_phase1.py compares the
# two files so they cannot drift apart.
#
# Nothing here is a real credential. The API refuses to start with the
# placeholder SECRET_KEY, DEBUG=true, or a wildcard CORS origin when
# ENV=production or ENV=staging.

# ----------------------------------------------------------------- application
PROJECT_NAME=NER Logistics Resilience Platform
# development | staging | production | test
ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# Structured JSON logs; set false for readable local output.
LOG_JSON=true

# -------------------------------------------------------------------- security
# Signs every JWT. Rotating it invalidates all outstanding tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=ner-logistics
JWT_AUDIENCE=ner-logistics-api
# Short, because the access token is presented on every call. 1-1440.
ACCESS_TOKEN_EXPIRE_MINUTES=30
# The refresh token's only power is minting access tokens. 1-90.
REFRESH_TOKEN_EXPIRE_DAYS=7
# bcrypt cost. Raise as hardware improves; needs_rehash() upgrades existing
# hashes on next login, so no password reset campaign is required. 10-16.
BCRYPT_ROUNDS=12

# ----------------------------------------------------------- CORS and throttle
# Comma-separated or a JSON array. A wildcard is refused outside development.
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
# Requests per window, per client, for ordinary endpoints.
RATE_LIMIT_DEFAULT=120
# Tighter budget for /auth, where the cost of guessing must stay high.
RATE_LIMIT_AUTH=10
RATE_LIMIT_WINDOW_SECONDS=60
# Consecutive failures before an account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# --------------------------------------------------------------- file uploads
# Field-report photos land here. Bind-mounted in docker-compose so uploads
# survive a container rebuild.
UPLOAD_DIR=/data/uploads
# Per-file ceiling in MB. 1-100.
MAX_UPLOAD_MB=10
# Enforced by sniffing the file, not by trusting the declared Content-Type.
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp

# ------------------------------------------------------------------- database
# Use localhost for the native path; use "postgres" when the API runs in Docker.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ner
POSTGRES_PASSWORD=ner
POSTGRES_DB=ner_logistics
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Echoes every statement. Useful when a spatial query is slow, noisy otherwise.
DB_ECHO=false

# ---------------------------------------------------------------------- redis
# Use "redis" instead of localhost when the API runs in Docker.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ------------------------------------------------------- spatial reference IDs
# Everything is stored as WGS84 lon/lat and reprojected for metric work;
# distances and buffers in degrees are meaningless at this latitude.
DEFAULT_SRID=4326
# UTM zone 46N, which covers the North Eastern Region.
METRIC_SRID=32646
# --------------------------------------------------------------------- routing
# The engine talks to a provider through an interface, so this can change
# without touching scoring logic. "stub" returns a straight-line route and is
# what the test suite uses.
# osrm | graphhopper | valhalla | stub
ROUTING_PROVIDER=osrm
# "http://osrm:5000" inside Docker, "http://localhost:5000" natively.
OSRM_BASE_URL=http://osrm:5000
ROUTING_TIMEOUT_SECONDS=10.0
# How many distinct candidates to score before recommending one. 1-10.
ROUTE_CANDIDATE_COUNT=3

# -------------------------------------------------------------- data providers
# Provider choice is configuration, not code. The defaults are the honest ones:
# synthetic generators that are clearly labelled as such in the database
# (every row carries a provenance column) and in the UI.
#
# The IMD and Bhuvan settings exist so an authorised deployment can point at the
# real services later. Leaving the keys blank is the normal state — this project
# does not have access to restricted government feeds, and nothing here should
# be read as a claim that it does.
# synthetic | imd | openmeteo
WEATHER_PROVIDER=synthetic
# local_extract | overpass
OSM_PROVIDER=local_extract
# synthetic | bhuvan
HAZARD_PROVIDER=synthetic
# internal | external_feed
INCIDENT_PROVIDER=internal

# India Meteorological Department — requires an authorised agreement.
IMD_BASE_URL=
IMD_API_KEY=
# Open-Meteo is public and needs no key; usable for a real-weather demo.
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
# ISRO Bhuvan — requires an authorised agreement.
BHUVAN_BASE_URL=
BHUVAN_API_KEY=
# Public Overpass endpoint. Rate limited; prefer a local extract for bulk work.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
# Downloaded OSM extract for the region (see make osm-download).
OSM_EXTRACT_PATH=/data/osm/northeast-india-latest.osm.pbf
# ------------------------------------------------------------- language model
# The copilot is a natural-language shell over validated backend tools. It never
# routes, scores risk, or writes to the database directly, and the platform is
# fully usable with LLM_ENABLED=false — which is the default precisely so the
# core application does not depend on a model being up.
LLM_ENABLED=false
# ollama | openai_compatible | stub
LLM_PROVIDER=ollama
# From inside a container, the host's Ollama is reachable on host.docker.internal
# (on Linux add: extra_hosts: ["host.docker.internal:host-gateway"]).
# Running the API natively, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Must match a tag from `ollama list`.
LLM_MODEL=qwen3:30b-a3b
LLM_TIMEOUT_SECONDS=120.0
LLM_MAX_TOKENS=1024
# Low, because this is a tool-calling interface over real data, not prose.
LLM_TEMPERATURE=0.1
# Hard ceiling on tool calls per turn, so a confused model cannot loop.
LLM_MAX_TOOL_CALLS=5

# ------------------------------------------------------- realtime and tracking
# WebSocket keepalive; also how quickly a dead client is noticed.
WS_HEARTBEAT_SECONDS=25
# Replays vehicle movement along assigned routes for the demo. Positions written
# by the simulator are stored with provenance=SIMULATED, so they can never be
# mistaken for device telemetry.
GPS_SIMULATOR_ENABLED=false
GPS_SIMULATOR_INTERVAL_SECONDS=5.0

# --------------------------------------------------------- bootstrap and seeds
# The first administrator, created by services/api/scripts/seed.py.
BOOTSTRAP_ADMIN_EMAIL=admin@ner-logistics.local
# Leave blank in development and the seeder generates one and prints it once.
# Outside development it must be set: a generated secret would have to be
# printed, and a printed secret ends up in the deployment log.
BOOTSTRAP_ADMIN_PASSWORD=
# Whether `make seed-demo` may load the synthetic corridor and shipment set.
# Reference data (roles, commodities, weights, states, districts) is seeded
# regardless; this flag only gates the generated demo scenario.
SEED_SYNTHETIC_DATA=true

# ------------------------------------------------------------ web app (Next.js)
# Read by apps/web at build time; not part of the API settings class.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000/api/v1/ws
# Free raster basemap that needs no key. Swap for a self-hosted style to remove
# the last external dependency from the map.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_DEFAULT_LOCALE=en
